i]);\r\n      const prevX = xScale(i - 1);\r\n      const prevY = yScale(points[i - 1]);\r\n      const cpX1 = prevX + (x - prevX) / 3;\r\n      const cpX2 = x - (x - prevX) / 3;\r\n      path += ` C ${cpX1} ${prevY}, ${cpX2} ${y}, ${x} ${y}`;\r\n    }\r\n    return path;\r\n  };\r\n\r\n  const createAreaPath = (points: number[]) => {\r\n    const linePath = createPath(points);\r\n    const bottomY = yScale(0);\r\n    return `${linePath} L ${xScale(points.length - 1)} ${bottomY} L ${xScale(0)} ${bottomY} Z`;\r\n  };\r\n\r\n  return (\r\n    <div ref={containerRef} className=\"w-full\">\r\n      {/* Legend */}\r\n      <div className=\"flex items-center space-x-4 mb-4 text-xs\">\r\n        {data.series.map((series, index) => (\r\n          <div key={index} className=\"flex items-center space-x-2\">\r\n            <div\r\n              className=\"w-2 h-2 rounded-full\"\r\n              style={{ backgroundColor: series.color }}\r\n            ></div>\r\n            <span className=\"text-gray-600\">{series.name}</span>\r\n          </div>\r\n        ))}\r\n      </div>\r\n\r\n      <div className=\"relative\">\r\n        <svg\r\n          width=\"100%\"\r\n          height={height}\r\n          viewBox={`0 0 ${width} ${height}`}\r\n          preserveAspectRatio=\"none\"\r\n        >\r\n          {/* Grid lines */}\r\n          {[0, 250, 500, 750, 1000, 1250, 1500, 1750].map((value, index) => (\r\n            <g key={index}>\r\n              <line\r\n                x1={padding.left}\r\n                y1={yScale(value)}\r\n                x2={width - padding.right}\r\n                y2={yScale(value)}\r\n                stroke=\"#f1f5f9\"\r\n                strokeDasharray=\"4 4\"\r\n              />\r\n              <text\r\n                x={padding.left - 15}\r\n                y={yScale(value) + 4}\r\n                textAnchor=\"end\"\r\n                fontSize=\"12\"\r\n                fill=\"#64748b\"\r\n                fontFamily=\"system-ui\"\r\n              >\r\n                {value}\r\n              </text>\r\n            </g>\r\n          ))}\r\n\r\n          {/* Area Fills */}\r\n          {data.series.map((series, index) => (\r\n            <path\r\n              key={`area-${index}`}\r\n              d={createAreaPath(series.data)}\r\n              fill={series.color}\r\n              fillOpacity=\"0.15\"\r\n            />\r\n          ))}\r\n\r\n          {/* Lines */}\r\n          {data.series.map((series, index) => (\r\n            <path\r\n              key={`line-${index}`}\r\n              d={createPath(series.data)}\r\n              fill=\"none\"\r\n              stroke={series.color}\r\n              strokeWidth=\"2.5\"\r\n            />\r\n          ))}\r\n\r\n          {/* X-axis Labels */}\r\n          {data.months.map((month, index) => (\r\n            <text\r\n              key={index}\r\n              x={xScale(index)}\r\n              y={height - 20}\r\n              textAnchor=\"middle\"\r\n              fontSize=\"12\"\r\n              fill=\"#64748b\"\r\n              fontFamily=\"system-ui\"\r\n            >\r\n              {month}\r\n            </text>\r\n          ))}\r\n        </svg>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default AreaChart;\r\n","usedDeprecatedRules":[]},{"filePath":"E:\\Projects\\FSD\\lawalx-superadmin-frontend\\src\\components\\admin\\analytics\\BarChart.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"E:\\Projects\\FSD\\lawalx-superadmin-frontend\\src\\components\\admin\\analytics\\DonutChart.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"E:\\Projects\\FSD\\lawalx-superadmin-frontend\\src\\components\\admin\\analytics\\dataService.ts","messages":[],"suppressedMessages":[],"errorCount":0